# Copy these values into your Vercel project settings (Environment Variables).
# NEVER commit real values to GitHub. This file is just a list of what is needed.

# Neon Postgres connection string (use the laban_app role, not the owner role)
DATABASE_URL=postgresql://laban_app:YOUR-PASSWORD@YOUR-NEON-HOST/neondb?sslmode=require

# Random 64-character hex string that signs admin session cookies
SESSION_SECRET=generate-a-long-random-string

# Random slug that makes the admin URL unguessable: /manage/<ADMIN_URL_KEY>
ADMIN_URL_KEY=generate-a-random-slug

# First-ever admin sign-in password. After the first successful sign-in,
# change it inside the admin panel and this value stops mattering.
ADMIN_INITIAL_PASSWORD=choose-a-strong-first-password
